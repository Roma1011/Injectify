<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>Injectify.Auto</PackageId>
    <Version>1.0.2</Version>
    <Authors>Roma 1011</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Description>A lightweight utility for automatically registering services in .NET using custom attributes (Singleton, Scoped, and Transient) via assembly scanning.</Description>
    <PackageTags>dependency-injection;di;attributes;scanning;auto-register</PackageTags>
    <RepositoryUrl>https://github.com/Roma1011/Injectify</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
  </ItemGroup>

</Project>